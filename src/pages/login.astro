---
import Layout from "../layouts/Layout.astro";
import "../styles/admin.css";
---

<Layout>
  <main class="admin-shell admin-shell--login">
    <section id="admin-login" class="admin-panel">
      <div class="admin-brand">CHOPIN / ADMIN ACCESS</div>
      <p class="admin-hint">Login pakai akun GitHub yang sudah diizinkan di Supabase.</p>
      <button type="button" id="github-login-btn" class="admin-google-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.11.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 2.87-.39c.97.01 1.95.13 2.87.39 2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.73.8 1.18 1.83 1.18 3.09 0 4.42-2.7 5.39-5.26 5.68.42.36.78 1.07.78 2.16 0 1.56-.01 2.82-.01 3.2 0 .31.2.67.79.55A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
        <span>LOGIN DENGAN GITHUB</span>
      </button>
      <p id="login-error" class="admin-error" hidden></p>
    </section>
  </main>

  <script>
    import "../scripts/login.js";
  </script>
</Layout>
